{
  "name": "gravity-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Shake Table Lab: an earthquake shake table lab built on three.js, Poly Haven and Rapier",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "characterize": "node scripts/characterize-prototype.ts",
    "assets:sync": "node scripts/assets-sync.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/three": "0.181.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@preact/signals": "2.11.3",
    "preact": "10.29.8",
    "three": "0.181.2"
  }
}
