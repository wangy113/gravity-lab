{
  "name": "gravity-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Shake Table Lab: an earthquake shake table lab built on three.js, Poly Haven and Rapier",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "characterize": "node scripts/characterize-prototype.ts",
    "assets:sync": "node scripts/assets-sync.ts",
    "test:e2e": "playwright test",
    "assets:build": "node scripts/assets-build.ts",
    "assets:budget": "node scripts/assets-budget.ts",
    "fingerprint": "node scripts/fingerprint.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@dimforge/rapier3d-deterministic-compat": "0.21.0",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@preact/signals": "2.11.3",
    "preact": "10.29.8",
    "three": "0.186.1"
  }
}
